# =============================================================================
# Wazuh Docker deployment - environment file
#
#   ./scripts/init-env.sh     copies this file to .env and replaces every
#                             __GENERATE*__ token with a fresh random secret.
#
# .env is git-ignored and created with mode 600. Never commit it.
#
# Password policy (enforced by scripts/wazuhctl.py validate):
#   12-64 chars, upper + lower + digit + one of . * + ? -
#   allowed characters: A-Z a-z 0-9 . * + ? - _ @ = ^ ~ % , :
#   no $ " ' \ ` # & or spaces (they break compose / YAML / shell quoting)
# =============================================================================

COMPOSE_PROJECT_NAME=wazuh
WAZUH_VERSION=4.12.0
CERTS_GENERATOR_VERSION=0.0.2
INDEXER_HEAP=1g
DASHBOARD_PORT=443
# Set to 127.0.0.1 to keep the Wazuh API off the network (dashboard still works).
API_BIND=0.0.0.0

# ----------------------------------------------------------------------------
# Credentials that REPLACE the Wazuh defaults
# ----------------------------------------------------------------------------
# Indexer 'admin' (default: admin / SecretPassword) - also the dashboard login
INDEXER_ADMIN_PASSWORD=__GENERATE__
# Indexer 'kibanaserver' used by the dashboard backend (default: kibanaserver)
DASHBOARD_KIBANASERVER_PASSWORD=__GENERATE__
# Wazuh API administrator 'wazuh' (default: wazuh)
API_ADMIN_PASSWORD=__GENERATE__
# Wazuh API user the dashboard uses (default: wazuh-wui / MyS3cr37P450r.*-)
API_WUI_USERNAME=wazuh-wui
API_WUI_PASSWORD=__GENERATE__
# Manager cluster key (32 hex chars, only used if clustering is enabled)
WAZUH_CLUSTER_KEY=__GENERATE_HEX32__

# ----------------------------------------------------------------------------
# Agent enrollment
# ----------------------------------------------------------------------------
# Enrollment key (wazuh-authd password). Agents need it to register.
ENROLLMENT_PASSWORD=__GENERATE__
# true = agents must ALSO present a client cert signed by the agent CA
# (run scripts/generate-agent-certs.sh first)
AGENT_CERT_VERIFICATION=false

# ----------------------------------------------------------------------------
# Wazuh -> MISP / TheHive integrations (rendered into ossec.conf)
# ----------------------------------------------------------------------------
ENABLE_MISP=false
# Use the service name when MISP runs in docker-compose.soar.yml
MISP_URL=https://misp-core
# MISP automation key (Administration > List Auth Keys). Can equal MISP_ADMIN_KEY
# for a lab; create a dedicated read-only user for production.
MISP_API_KEY=
MISP_VERIFY_SSL=false
MISP_TIMEOUT=10
MISP_RULE_GROUPS=sysmon_event1,sysmon_event3,sysmon_event6,sysmon_event7,sysmon_event_15,sysmon_event_22,syscheck

ENABLE_THEHIVE=false
THEHIVE_URL=http://thehive:9000
# API key of a TheHive user with the 'analyst' profile in your organisation
THEHIVE_API_KEY=
THEHIVE_MIN_LEVEL=7
THEHIVE_VERIFY_SSL=false
THEHIVE_TIMEOUT=10
THEHIVE_TLP=2
THEHIVE_PAP=2

# ----------------------------------------------------------------------------
# Optional SOAR/CTI stack (docker-compose.soar.yml): MISP + TheHive + Cortex
# ----------------------------------------------------------------------------
ENABLE_SOAR_STACK=false

# MISP
MISP_BASE_URL=https://localhost:8443
MISP_PORT=8443
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_ORG=SOC
MISP_ADMIN_PASSWORD=__GENERATE__
MISP_ADMIN_KEY=__GENERATE_KEY40__
MISP_DB_PASSWORD=__GENERATE__
MISP_DB_ROOT_PASSWORD=__GENERATE__
MISP_REDIS_PASSWORD=__GENERATE__

# TheHive 5
THEHIVE_VERSION=5.4
THEHIVE_PORT=9000
THEHIVE_SECRET=__GENERATE_SECRET__

# Cortex 3
CORTEX_VERSION=3.1.8-1
CORTEX_PORT=9001
CORTEX_SECRET=__GENERATE_SECRET__
CORTEX_JOB_DIR=/tmp/cortex-jobs
